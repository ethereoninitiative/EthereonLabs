[Unit]
Description=Lumina Governed Observation One-Shot Cycle
After=local-fs.target

[Service]
Type=oneshot
User=lumina
Group=lumina
WorkingDirectory=/opt/lumina/EthereonLabs
ExecStart=/usr/bin/python3 /opt/lumina/EthereonLabs/deploy/ubuntu_server_lts/governed_appliance_cycle_r1.py --state-root /var/lib/lumina
StateDirectory=lumina
StateDirectoryMode=0700
LogsDirectory=lumina
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=90
StandardOutput=append:/var/log/lumina/orchestrator.log
StandardError=append:/var/log/lumina/orchestrator.log

[Install]
WantedBy=multi-user.target

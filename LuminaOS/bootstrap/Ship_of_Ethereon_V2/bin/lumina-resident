#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from pathlib import Path

BOOTSTRAP_ROOT = Path(__file__).resolve().parents[1]
TARGET = BOOTSTRAP_ROOT / "studio" / "lumina_resident_r1.py"


def main() -> int:
    cmd = [sys.executable or "python3", str(TARGET), "--resident", *sys.argv[1:]]
    return int(subprocess.run(cmd, cwd=str(BOOTSTRAP_ROOT)).returncode)


if __name__ == "__main__":
    raise SystemExit(main())
